# Copy to .env and fill in your values.

# Stripe (required for checkout → Stripe redirect)
STRIPE_SECRET_KEY=sk_live_or_sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_live_or_pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Supabase service role (required for admin settings + orders in database)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Admin panel login (local / self-hosted)
JWT_SECRET=change-me-to-a-long-random-string
ADMIN_PASSWORD=choose-a-strong-password

# Already provided by Lovable in many projects:
# SUPABASE_URL=
# SUPABASE_PUBLISHABLE_KEY=
